{
  "name": "simu-api",
  "version": "1.0.0",
  "private": true,
  "description": "Express REST API with user CRUD and JWT authentication",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test test/api.test.mjs test/middleware.test.mjs test/rateLimit.test.mjs",
    "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:all": "npm test && npm run test:unit"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "supertest": "^7.3.1"
  }
}
