# 复制为 .env 后按需修改
PORT=3000
# 日志级别: debug | info | warn | error | silent
LOG_LEVEL=info
# 限流：每个 IP 在窗口内允许的请求数（0 = 关闭）
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
# 部署在 nginx / 负载均衡后面时必须开启，否则 req.ip 全是代理地址（1 / true / loopback）
# TRUST_PROXY=1
JWT_SECRET=please-change-me-to-a-long-random-string
JWT_EXPIRES_IN=1h
# 首次启动时创建的管理员账号
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@12345
